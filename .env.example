# Optional: enables live answers through the OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra

# Public production origin, for example https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set this to your payment or community onboarding URL before deployment.
NEXT_PUBLIC_COMMUNITY_JOIN_URL=

# Optional: enables privacy-conscious GA4 page views and coarse interaction events.
# Leave blank to keep analytics disabled. Use a GA4 Measurement ID such as G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
